# Primus environment — copy to .env (or export) and adjust. All optional; the defaults
# below are what a stock local install uses. Never commit a real .env.

# Ollama server URL (host install default: http://localhost:11434; docker compose sets
# http://ollama:11434 for you)
OLLAMA_URL=http://localhost:11434

# Where Primus keeps state: knowledge base, memories, chat history, exports, tokens
PRIMUS_DATA_DIR=~/.primus

# Where Primus keeps config.json, logs, and identity overrides (operator.json,
# personality_override.md, seed_knowledge.json, business_context.json)
PRIMUS_CONFIG_DIR=~/.config/primus

# UI bind — keep 127.0.0.1 unless you front it with an authenticated proxy (see SECURITY.md)
PRIMUS_HOST=127.0.0.1
PRIMUS_PORT=7860

# Optional model overrides
# PRIMUS_MODEL=qwen2.5:7b
# PRIMUS_FORGE_MODEL=qwen2.5-coder:7b
# PRIMUS_FAST_MODEL=llama3.2:3b

# Optional operator identity (same effect as ~/.config/primus/operator.json name fields)
# PRIMUS_OPERATOR_NAME=Ada
# PRIMUS_OPERATOR_FULL_NAME=Ada Lovelace
